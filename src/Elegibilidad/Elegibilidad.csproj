<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Elegibilidad</RootNamespace>
    <Version>0.2.0</Version>
    <Authors>Jorge Luis Saraiva Ruas</Authors>
    <Company>Inge Innova</Company>
    <Copyright>Copyright (c) 2026 Jorge Luis Saraiva Ruas</Copyright>
    <PackageProjectUrl>https://github.com/saraivaruas/elegibilidad-fondos</PackageProjectUrl>
    <RepositoryUrl>https://github.com/saraivaruas/elegibilidad-fondos</RepositoryUrl>
    <Description>Motor determinista de elegibilidad para fondos y programas de financiamiento en Chile.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Catalogo\fondos.json" LogicalName="fondos.json" />
  </ItemGroup>
</Project>
